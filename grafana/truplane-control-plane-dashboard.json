{
  "editable": true,
  "title": "Truplane v3 Control Plane — Unified Reliability & FinOps",
  "uid": "truplane-control-plane-v3",
  "schemaVersion": 39,
  "tags": ["truplane", "finops", "focus-1.5", "k8s-safescale", "data-snap", "drift-gate"],
  "panels": [
    {
      "id": 1,
      "title": "Total FOCUS Effective Spend (USD)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "focus_ledger_total_effective_cost_usd", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "K8s SafeScale Verified Monthly Savings (USD)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(focus_ledger_rightsizing_savings_usd)", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Data Snap Cost of Quality Incidents (USD)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(focus_ledger_data_quality_cost_usd)", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Drift Gate Out-of-Band Drift & Policy Violations",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "drift_gate_drift_detected_total", "legendFormat": "Drift", "refId": "A" },
        { "expr": "sum(drift_gate_policy_violations_total)", "legendFormat": "Violations", "refId": "B" }
      ]
    },
    {
      "id": 5,
      "title": "Spend Attribution by Team & Source",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum by (team, source) (focus_ledger_effective_cost_usd)", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "3-Sigma Spend Anomaly Z-Scores",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "expr": "focus_ledger_spend_anomaly_zscore", "legendFormat": "{{source}}/{{team}}", "refId": "A" }]
    },
    {
      "id": 7,
      "title": "K8s SafeScale Resizes & Automatic Rollbacks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "sum by (outcome) (safescale_resizes_total)", "legendFormat": "Resize: {{outcome}}", "refId": "A" },
        { "expr": "sum by (reason) (safescale_rollbacks_total)", "legendFormat": "Rollback: {{reason}}", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "title": "Drift Gate Estimated Monthly Cost Delta & Blast Radius",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "drift_gate_estimated_monthly_cost_delta_usd", "legendFormat": "Est. Monthly Delta ($)", "refId": "A" },
        { "expr": "drift_gate_blast_radius_score", "legendFormat": "Blast Radius Score", "refId": "B" }
      ]
    }
  ]
}
